{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@\n原文件：%@\n%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\nOriginal file: %2$@\n%3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n元のファイル：%2$@\n%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n原始檔案：%2$@\n%3$@"
          }
        }
      }
    },
    "%lld 件放这里": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Place %lld item here"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Place %lld items here"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件をここに置く"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件放這裡"
          }
        }
      }
    },
    "%lld/%lld": {
      "shouldTranslate": false
    },
    "HangDry": {
      "shouldTranslate": false
    },
    "• %@：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "• %1$@：%2$@"
          }
        }
      }
    },
    "⚠️ 剪贴板权限被拒绝，去系统设置开启…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Clipboard access denied — open System Settings…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ クリップボードへのアクセスが拒否されています。システム設定を開く…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 剪貼簿權限被拒絕，前往系統設定開啟…"
          }
        }
      }
    },
    "一直展开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Open"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に表示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一直展開"
          }
        }
      }
    },
    "之后新出现的文件都会自动挂上。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New files will be hung automatically from now on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後追加されるファイルは自動で掛けられます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後新出現的檔案都會自動掛上。"
          }
        }
      }
    },
    "从剪贴板挂上 %lld 件": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Hung %lld item from the clipboard"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Hung %lld items from the clipboard"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードから %lld 件掛けました"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從剪貼簿掛上 %lld 件"
          }
        }
      }
    },
    "从剪贴板挂上 1 张图片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hung 1 image from the clipboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードから画像を 1 枚掛けました"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從剪貼簿掛上 1 張圖片"
          }
        }
      }
    },
    "从绳上取下": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take Off the Line"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロープから外す"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從繩上取下"
          }
        }
      }
    },

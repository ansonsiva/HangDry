    "停止监听": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Watching"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視をやめる"
          }

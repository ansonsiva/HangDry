    "先把文件拖到晾衣绳上。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag some files onto the clothesline first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずファイルを物干しロープにドラッグしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先把檔案拖到曬衣繩上。"
          }
        }
      }
    },
